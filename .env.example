# ===========================================
# Environment Configuration Template
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Application Environment
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# ===========================================
# Backend Configuration
# ===========================================

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Database Configuration
# ===========================================

# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/kyc_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kyc_db
DB_USER=kyc_user
DB_PASSWORD=kyc_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# DynamoDB (Sessions & State)
DYNAMODB_ENDPOINT=http://localhost:4566  # LocalStack
AWS_REGION=us-east-1
DYNAMODB_SESSIONS_TABLE=kyc-sessions
DYNAMODB_AGENT_STATE_TABLE=kyc-agent-state

# ===========================================
# AWS Configuration
# ===========================================

# AWS Credentials
AWS_ACCESS_KEY_ID=test  # LocalStack test credentials
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# S3 Configuration
S3_ENDPOINT=http://localhost:4566  # LocalStack
S3_DOCUMENTS_BUCKET=kyc-documents-dev
S3_SNAPSHOTS_BUCKET=kyc-snapshots-dev

# AWS Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TEMPERATURE=0.0

# ===========================================
# Authentication & Security
# ===========================================

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# ===========================================
# External APIs
# ===========================================

# Document Processing
AWS_TEXTRACT_ENDPOINT=http://localhost:4566  # LocalStack

# Screening API (Mock/Real)
SCREENING_API_URL=http://localhost:8001/screening
SCREENING_API_KEY=your-screening-api-key
SCREENING_API_TIMEOUT=30

# Enrichment API (Mock/Real)
ENRICHMENT_API_URL=http://localhost:8002/enrichment
ENRICHMENT_API_KEY=your-enrichment-api-key
ENRICHMENT_API_TIMEOUT=30

# ===========================================
# Observability
# ===========================================

# Logging
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text

# Tracing
ENABLE_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=kyc-agentic-system-dev

# Metrics
ENABLE_METRICS=true

# ===========================================
# Agent Configuration
# ===========================================

# LangGraph Configuration
LANGGRAPH_CHECKPOINT_BACKEND=dynamodb
LANGGRAPH_MAX_ITERATIONS=50

# Agent Timeouts (seconds)
INTAKE_AGENT_TIMEOUT=30
DOCUMENT_INGEST_AGENT_TIMEOUT=60
SCREENING_AGENT_TIMEOUT=45
ENTITY_RESOLUTION_AGENT_TIMEOUT=30
ENRICHMENT_AGENT_TIMEOUT=45
RISK_SCORING_AGENT_TIMEOUT=30
SOW_REVIEW_AGENT_TIMEOUT=60
WORKFLOW_AGENT_TIMEOUT=120
AUDIT_AGENT_TIMEOUT=15

# ===========================================
# Frontend Configuration
# ===========================================

# API URLs
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws

# Feature Flags
VITE_ENABLE_DEV_TOOLS=true
VITE_ENABLE_MOCK_DATA=false

# ===========================================
# Testing
# ===========================================

# Test Database
TEST_DATABASE_URL=postgresql://kyc_user:kyc_password@localhost:5432/kyc_test_db

# Test AWS
TEST_AWS_ENDPOINT=http://localhost:4566
TEST_S3_BUCKET=kyc-test-documents

# ===========================================
# LocalStack Configuration
# ===========================================

LOCALSTACK_ENDPOINT=http://localhost:4566
LOCALSTACK_HOSTNAME=localhost
EDGE_PORT=4566
